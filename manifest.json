{
  "manifest_version": 3,
  "name": "Ramsey Classroom Unlocked",
  "version": "1.0.0",
  "description": "Extension for Ramsey Classroom.",

  "action": {
    "default_title": "Ramsey Classroom Unlocked"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.ramseyclassroom.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "images/eye.png"
      ],
      "matches": [
        "https://www.ramseyclassroom.com/*"
      ]
    }
  ]
}
